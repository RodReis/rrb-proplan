{
  "description": "Office3D Codex hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/office3d.cjs SessionStart",
            "timeout": 5,
            "statusMessage": "Office3D HUD"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/office3d.cjs PreToolUse",
            "timeout": 5,
            "statusMessage": "Office3D HUD"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/office3d.cjs PostToolUse",
            "timeout": 5,
