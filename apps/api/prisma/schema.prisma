generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime: role NÃO-owner (proplan_app), sujeita a RLS (Fatia 8, SPEC-022).
  url      = env("DATABASE_URL")
  // Migrations/seed: role owner (proplan), precisa de DDL e ignora RLS.
  directUrl = env("DIRECT_URL")
}

// Conta no ProPlan (SPEC-026). A identidade é o IdP (Google); o GitHub deixa de
// ser quem o usuário é e passa a ser o que ele conectou. Por isso `githubId`
// virou nullable: uma conta nasce só com Google e pode nunca conectar o GitHub.
// Os campos de token do GitHub seguem aqui por ora — mudam para `Connection` no
// PR seguinte da #94; movê-los junto com a troca de IdP dobraria o raio de risco
// sobre o `github-auth.service`, que é o coração da leitura (ADR-015).
model User {
  id                     String    @id @default(uuid())
  githubId               BigInt?   @unique @map("github_id")
  // Identidade do IdP. `googleId` é o `sub` do OpenID — estável mesmo se o
  // usuário trocar o email da conta Google. `email` é @unique porque é a chave
  // que casa o usuário pré-existente (identidade-GitHub) com a conta Google no
  // primeiro login pós-deploy.
  googleId               String?   @unique @map("google_id")
  email                  String?   @unique
  login                  String
  name                   String?
  avatarUrl              String?   @map("avatar_url")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  projects               Project[]
  memberships            Membership[]
  connections            Connection[]

  @@map("users")
}

// Conexão com um provedor externo (SPEC-025/026, ADR-021). É o que o usuário
// **conectou** — distinto de quem ele **é** (`User`, vindo do IdP). É essa
// separação que faz *desconectar ≠ deslogar*: revogar a conexão apaga os tokens
// daqui e o `User` (com projetos e tenants) fica de pé.
//
// `provider` é texto livre e hoje só vale `"github"`. GitLab/Jira/Notion entram
// sem migration — a costura está pronta e dormente, como a SPEC-026 decidiu.
//
// `1:N no schema, 1 na UI`: o `@@unique([userId, provider])` garante **uma**
// conexão por provedor, mas o mesmo usuário pode ter várias linhas de provedores
// diferentes. Desconectar **deleta a linha** em vez de marcar inativa: token
// revogado não tem valor guardado, e uma linha ausente é um estado mais simples
// de ler do que uma linha inativa com campos mortos.
model Connection {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              String
  encryptedUserToken    String?   @map("encrypted_user_token")
  encryptedRefreshToken String?   @map("encrypted_refresh_token")
  tokenExpiresAt        DateTime? @map("token_expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([userId, provider])
  @@map("connections")
}

// Tenant = dono de projetos, membros e teto de IA (SPEC-022, Fatia 8).
// ENTIDADE PRÓPRIA com PK própria — não o id de instalação do GitHub. Por quê:
// o installationId do GitHub NÃO é estável (desinstalar+reinstalar emite id
// novo). Com PK própria, um reinstall só RE-APONTA `installationId` no mesmo
// Tenant e nenhum dado orfana. No 1º corte a relação é 1:1 (tenant = instalação
// = org); a PK própria só não fecha a porta para N instalações no futuro.
model Tenant {
  id             String       @id @default(uuid())
  // Nullable: tenant pessoal pode nascer sem instalação de org. @unique: a
  // relação é 1:1 e re-apontável no reinstall.
  installationId Int?         @unique @map("installation_id")
  // Id numérico da conta no GitHub — a chave de casamento no reinstall. É o
  // ÚNICO identificador estável da conta: `installationId` muda a cada
  // reinstall e `accountLogin` muda num rename. Nullable porque as linhas
  // pré-existentes nascem sem ele (a migration não chama a rede); o primeiro
  // `listInstallations` preenche. @unique: uma conta = um tenant (1:1).
  accountId      Int?         @unique @map("account_id")
  accountLogin   String       @map("account_login")
  accountType    String       @map("account_type") // User | Organization
  createdAt      DateTime     @default(now()) @map("created_at")
  memberships    Membership[]
  projects       Project[]
  settings       Settings[]
  // Frente Clientes (SPEC-029): raízes de tenancy do MVP3.
  clients        Client[]
  auditEvents    AuditEvent[]
  // Briefing público (SPEC-031): catálogo curado é por tenant.
  serviceCatalogItems ServiceCatalogItem[]

  @@map("tenants")
}

enum Role {
  owner  // gerencia projeto, administra membros, é o ÚNICO que finaliza (ADR-011)
  member // opera o board, dispara sync, vê custo
  viewer // só leitura
}

// Vínculo usuário↔tenant com papel (SPEC-022). Papel derivado do acesso do
// GitHub (PR-5), mas gravado aqui (coluna própria) para desacoplar de um
// eventual SSO sem migração.
model Membership {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  role      Role
  createdAt DateTime @default(now()) @map("created_at")
  // Último recálculo do papel a partir do GitHub (SPEC-022 E2, decisão 2).
  // Throttle PERSISTENTE: em memória, cada reinício da API zeraria a janela e
  // toda abertura de catálogo viraria request à API do GitHub. Nullable: linhas
  // pré-migration nunca foram recalculadas, e null força o primeiro cálculo.
  roleSyncedAt DateTime? @map("role_synced_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

enum InstallationStatus {
  active
  missing
}

model Project {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  // Nullable no schema para o backfill (migração da Fatia 8 preenche e depois
  // um ALTER torna NOT NULL — Prisma não modela "NOT NULL após backfill", então
  // o SQL da migração faz o SET NOT NULL; a coluna é obrigatória de fato).
  tenantId     String?  @map("tenant_id")
  githubRepoId BigInt   @map("github_repo_id")
  owner        String
  name         String
  description  String?
  defaultBranch String  @map("default_branch")
  isPrivate    Boolean  @map("is_private")
  installationId     Int?               @map("installation_id")
  installationStatus InstallationStatus @default(active) @map("installation_status")
  docsScopeHash String? @map("docs_scope_hash")
  lastSyncAt   DateTime? @map("last_sync_at")
  lastDocsCommitAt   DateTime? @map("last_docs_commit_at")
  lastCodeCommitAt   DateTime? @map("last_code_commit_at")
  commitMetaSyncedAt DateTime? @map("commit_meta_synced_at")
  needsIssueImport   Boolean  @default(false) @map("needs_issue_import")
  proplanConfigInvalid Boolean @default(false) @map("proplan_config_invalid")
  deployVerdict    String?   @map("deploy_verdict")
  deploySignals    Json?     @map("deploy_signals")
  deployObservedAt DateTime? @map("deploy_observed_at")
  ciStatus         String?   @map("ci_status")
  ciConclusionUrl  String?   @map("ci_conclusion_url")
  ciObservedAt     DateTime? @map("ci_observed_at")
  // SPEC-023: stack detectada via SBOM. `stackEnabled` false = Dependency Graph
  // desabilitado/vazio (fallback informativo, não erro). `stackSourceSha` ancora
  // ao HEAD do default branch — NÃO ao docs_tree_sha: o SBOM é função dos
  // manifests, não de docs/ (variação registrada no ARCHITECTURE → Resiliência).
  stackEnabled     Boolean?  @map("stack_enabled")
  stackEcosystems  Json?     @map("stack_ecosystems")
  stackPackages    Json?     @map("stack_packages")
  stackSourceSha   String?   @map("stack_source_sha")
  stackObservedAt  DateTime? @map("stack_observed_at")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // onDelete: Restrict — não apagar tenant que ainda tem projeto (a migração
  // torna tenantId NOT NULL; a relação é opcional no schema só pelo backfill).
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documents    Document[]
  syncRuns     SyncRun[]
  insights     Insight[]
  issues       Issue[]
  boardMutations BoardMutation[]
  resolutions    DocumentResolution[]
  suppressedLinks SuppressedLink[]
  operations     Operation[]
  llmUsage       LlmUsage[]
  insightRuns    InsightRun[]
  canonicalFields CanonicalField[]
  assertions     Assertion[]

  @@unique([userId, githubRepoId])
  @@map("projects")
}

model Document {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  path           String
  blobSha        String   @map("blob_sha")
  content        String
  frontmatter    Json?
  isConventional Boolean  @default(false) @map("is_conventional")
  kind           String   @default("markdown")
  byteSize       Int      @map("byte_size")
  updatedAt      DateTime @updatedAt @map("updated_at")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outLinks       DocLink[] @relation("source")
  inLinks        DocLink[] @relation("target")

  @@unique([projectId, path])
  @@map("documents")
}

enum DocLinkKind {
  explicit
  inferred
}

model DocLink {
  id               String      @id @default(uuid())
  projectId        String      @map("project_id")
  sourceDocumentId String      @map("source_document_id")
  targetDocumentId String?     @map("target_document_id")
  targetPath       String      @map("target_path")
  kind             DocLinkKind @default(explicit)
  anchor           String?
  reason           String?
  source           Document    @relation("source", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  target           Document?   @relation("target", fields: [targetDocumentId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([sourceDocumentId])
  @@map("doc_links")
}

// Cache derivado da resolução de documentos (ADR-014, Fatia 6). NÃO é fonte —
// a decisão do usuário mora em .proplan/config.yml no repo. Apagar estas linhas
// e re-sincronizar reconstrói a resolução idêntica. `docsTreeSha` e `resolvedAt`
// preparam o nível 3 (Fatia 7, insight): job assíncrono versionado por tree-sha
// grava aqui com source: 'inference' — daí os campos entram já nesta migration.
model DocumentResolution {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  entity      String   // architecture | decisions | design | testing | deploy | skills
  level       Int      // 1 | 2 | 4
  source      String   // convention | alias | config | absent | inference (Fatia 7)
  path        String?
  paths       String[]
  confidence  Float
  docsTreeSha String?  @map("docs_tree_sha")
  resolvedAt  DateTime @default(now()) @map("resolved_at")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, entity])
  @@map("document_resolutions")
}

// Modelo canônico (SPEC-014, Fatia 9): uma linha por (projeto, entidade, campo),
// com valor + classe de proveniência + confiança determinística e a conta.
// Reconstruível (padrão DocumentResolution, ADR-014): apagar + re-sync reproduz
// idêntico — a fonte é o repo, isto é índice.
model CanonicalField {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  entity          String   // architecture | decisions | design | testing | deploy | skills
  field           String   // nome do campo dentro da entidade (ex.: presence)
  value           Json?    // valor extraído (null = ausente)
  provenanceClass String   @map("provenance_class") // fato | inferencia | hipotese | assercao
  provenanceRef   Json     @map("provenance_ref")   // {path, sha, date} | {absent:true} | ...
  confidence      Float
  confidenceMath  Json     @map("confidence_math")  // {stalenessDays, cobertura, contradicao, drift}
  docsScopeHash   String   @map("docs_scope_hash")
  resolvedAt      DateTime @default(now()) @map("resolved_at")
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, entity, field])
  @@map("canonical_fields")
}

// Asserção humana (SPEC-015, ADR-013): índice reconstruível de docs/CONTEXT.md
// — a fonte viva é o repo; apagar o banco e re-sync reconstrói. Modelo próprio
// (não só CanonicalField) porque a asserção tem ciclo de vida: captura →
// revalidação. O CanonicalField de `constraints` é projeção sobre isto.
model Assertion {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  statement   String
  paths       String[]
  author      String
  // YYYY-MM-DD como no arquivo ('' = sem data, degradado)
  assertedAt  String   @map("asserted_at")
  assertedSha String   @map("asserted_sha")
  status      String   // vigente | a-revalidar
  body        String   @default("")
  contextPath String   @default("docs/CONTEXT.md") @map("context_path")
  createdAt   DateTime @default(now()) @map("created_at")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("assertions")
}

enum SyncStatus {
  queued
  running
  success
  noop
  failed
}

enum LlmProvider {
  anthropic
  openai
  openrouter
}

model Settings {
  id                        String      @id @default(uuid())
  userId                    String      @unique @map("user_id")
  // Teto de IA passa a ser por tenant (ADR-016 escopado, Fatia 8). Nullable no
  // schema pelo backfill; a migração preenche e torna NOT NULL.
  tenantId                  String?     @map("tenant_id")
  tenant                    Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  llmProvider               LlmProvider @default(anthropic) @map("llm_provider")
  docsStalenessThresholdDays Int        @default(90) @map("docs_staleness_threshold_days")
  // Teto de gasto de IA (ADR-016, SPEC-009). USD/mês, global (soma provedores).
  // Alerta = faixa âmbar; teto = nenhum job de IA enfileirado. 0 desliga o teto.
  llmAlertUsdMonthly        Decimal     @default(5)  @map("llm_alert_usd_monthly")  @db.Decimal(10, 4)
  llmHardCapUsdMonthly      Decimal     @default(20) @map("llm_hard_cap_usd_monthly") @db.Decimal(10, 4)
  // Limiar de recusa do modelo canônico (SPEC-014). Campo com confiança abaixo
  // disto responde "não sei" em vez de palpite. 0 desliga (mostra tudo cru).
  canonicalRefusalThreshold Float       @default(0.4) @map("canonical_refusal_threshold")
  updatedAt                 DateTime    @updatedAt @map("updated_at")

  @@map("settings")
}

enum InsightKind {
  summary
  status_bootstrap
  architecture_fallback
  design_fallback
  edges_marker
  classify_marker
}

enum InsightRunOutcome {
  generated
  reused
  failed
}

model Insight {
  id            String      @id @default(uuid())
  projectId     String      @map("project_id")
  kind          InsightKind
  // Renomeado de docs_tree_sha (SPEC-011, ADR-002 emendado): vira METADADO
  // histórico ("gerado quando a árvore era X" — insumo do drift no MVP2). A
  // CHAVE de invalidação passa a ser o inputHash.
  docsScopeHash String      @map("docs_scope_hash")
  // SHA-256(system + user + provider + model) — a chave de idempotência. Nasce
  // nullable: linhas antigas ficam NULL (cache-miss ⇒ 1 rodada de regeneração
  // por projeto no 1º sync após o deploy, e estabiliza — a migration NÃO
  // reconstrói o passado com a lógica de hoje, ADR-016).
  inputHash     String?     @map("input_hash")
  provider      String
  model         String
  inputTokens   Int         @map("input_tokens")
  outputTokens  Int         @map("output_tokens")
  content       Json
  createdAt     DateTime    @default(now()) @map("created_at")
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, kind, createdAt])
  @@index([projectId, kind, inputHash])
  @@map("insights")
}

// Append-only (SPEC-011, Decisão 1 do PI): uma linha por EXECUÇÃO de job de
// insight — generated | reused | failed. Alimenta o painel de Atividade
// (gerado × reaproveitado). NÃO é gasto (isso é LlmUsage) nem artefato (isso é
// Insight); um cache-hit vira `reused` aqui e NÃO cria linha em LlmUsage.
model InsightRun {
  id        String            @id @default(uuid())
  projectId String            @map("project_id")
  kind      InsightKind
  outcome   InsightRunOutcome
  inputHash String            @map("input_hash")
  // Nº de documentos que entraram no prompt desta execução (o painel mostra
  // "leu N documentos"). Nullable: linhas antigas e `reused` não têm. Não é a
  // lista de nomes — só a contagem, barata de derivar no gerador.
  docsRead  Int?              @map("docs_read")
  createdAt DateTime          @default(now()) @map("created_at")
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("insight_runs")
}

enum LlmUsageStatus {
  ok
  error
  discarded
}

enum CostSource {
  provider // custo veio na resposta do provedor (OpenRouter) — é fato
  table    // custo calculado da ModelPrice (Anthropic/OpenAI) — inferência auditável
  none     // sem preço cadastrado → costUsd null, priceMissing
}

// Ledger append-only do gasto de IA (ADR-016, SPEC-009). Uma linha por CHAMADA
// ao provedor — sucesso, erro, retry (attempt próprio), descarte. NUNCA update,
// nunca delete, nunca chaveado por docs_tree_sha. É o registro do gasto; a
// tabela `insights` continua sendo o cache do artefato — as duas param de se
// confundir. Sobrevive ao projeto (projectId vira null, sem cascade).
model LlmUsage {
  id                   String         @id @default(uuid())
  projectId            String?        @map("project_id")
  // Nullable PERMANENTE (exceção às outras raízes, F4). O ledger é append-only
  // e sobrevive ao projeto (projectId vira null no SetNull); linhas históricas
  // pré-Fatia-8 e órfãs de projeto ficam com tenantId NULL = tenant pessoal do
  // dono. A policy RLS trata NULL como pertencente ao tenant ativo pessoal.
  // Não há FK forte nem SET NOT NULL — a coluna é deliberadamente frouxa.
  tenantId             String?        @map("tenant_id")
  kind                 String         // summary | status_bootstrap | architecture_fallback | ...
  provider             String
  model                String
  attempt              Int            @default(1) // retry de JSON inválido = linha própria com attempt 1
  status               LlmUsageStatus
  inputTokens          Int            @map("input_tokens")
  outputTokens         Int            @map("output_tokens")
  cacheCreationTokens  Int            @default(0) @map("cache_creation_tokens")
  cacheReadTokens      Int            @default(0) @map("cache_read_tokens")
  // Dinheiro em Decimal (Postgres numeric) — Float acumula erro com frações de centavo.
  costUsd              Decimal?       @map("cost_usd") @db.Decimal(12, 8)
  costSource           CostSource     @map("cost_source")
  // Liga a chamada ao artefato Insight que ela gerou (SPEC-011): o painel de
  // Atividade casa InsightRun ↔ LlmUsage por (projectId, kind, inputHash) para
  // mostrar tokens/custo por linha. Nullable: chamadas fora do fluxo de gate
  // (ex.: proposeCards) não têm hash. NÃO é fonte de gasto — só chave.
  inputHash            String?        @map("input_hash")
  priceMissing         Boolean        @default(false) @map("price_missing")
  priceSnapshot        Json?          @map("price_snapshot") // as 4 tarifas usadas, congeladas
  pricedAt             DateTime?      @map("priced_at")
  errorCode            String?        @map("error_code")
  latencyMs            Int?           @map("latency_ms")
  createdAt            DateTime       @default(now()) @map("created_at")
  project              Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([projectId, createdAt])
  @@index([projectId, kind, inputHash])
  @@map("llm_usage")
}

// Preço por modelo (ADR-016). Editável na tela; custo é congelado na chamada
// via priceSnapshot no ledger — mudar aqui NUNCA reescreve gasto já registrado.
model ModelPrice {
  id              String   @id @default(uuid())
  provider        String
  model           String
  inputPer1M      Decimal  @map("input_per_1m") @db.Decimal(12, 6)
  outputPer1M     Decimal  @map("output_per_1m") @db.Decimal(12, 6)
  cacheWritePer1M Decimal  @default(0) @map("cache_write_per_1m") @db.Decimal(12, 6)
  cacheReadPer1M  Decimal  @default(0) @map("cache_read_per_1m") @db.Decimal(12, 6)
  effectiveFrom   DateTime @default(now()) @map("effective_from")
  source          String?  // link/nota de onde o preço veio
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([provider, model, effectiveFrom])
  @@map("model_prices")
}

model SyncRun {
  id            String     @id @default(uuid())
  projectId     String     @map("project_id")
  status        SyncStatus
  docsScopeHash String?    @map("docs_scope_hash")
  added         Int        @default(0)
  updated       Int        @default(0)
  removed       Int        @default(0)
  skipped       Int        @default(0)
  error         String?
  // Write-back propagation: quando um sync é disparado logo após o ProPlan
  // commitar um doc (promote, putMapping), estas colunas dizem qual (path,
  // blobSha) a Trees API precisa já refletir antes de o sync decidir noop —
  // a Git Trees API tem consistência eventual. Nulos = sync comum, sem espera.
  expectPath    String?    @map("expect_path")
  expectBlobSha String?    @map("expect_blob_sha")
  startedAt     DateTime   @default(now()) @map("started_at")
  finishedAt    DateTime?  @map("finished_at")
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, startedAt])
  @@map("sync_runs")
}

// As 6 colunas do board (SPEC-005, emenda 2026-07-13). Backlog = issue aberta
// sem label proplan:*. Feito = closed sem label (aguardando aceite do PI);
// Finalizado = closed + proplan:finalizado (aceito).
enum BoardColumn {
  backlog
  todo
  doing
  done
  finalized
  discarded
}

enum IssuePriority {
  alta
  media
  baixa
}

// Cache derivado da Issues API (ADR-011) — não é fonte. A verdade vive nas
// GitHub Issues; esta tabela espelha o último sync para render rápido.
model Issue {
  id         String        @id @default(uuid())
  projectId  String        @map("project_id")
  number     Int
  title      String
  state      String // open | closed (nativo do GitHub)
  column     BoardColumn
  priority   IssuePriority?
  assigneeLogin     String? @map("assignee_login")
  assigneeAvatarUrl String? @map("assignee_avatar_url")
  htmlUrl    String        @map("html_url")
  // Datas nativas do GitHub (fatos, não carimbos nossos): `createdAt` é quando a
  // issue nasceu — o card mostra em Backlog/A Fazer/Em Andamento/Feito ("aberta
  // desde"); `closedAt` é o aceite/descarte — mostrado em Finalizado/Descartado.
  createdAt  DateTime      @map("created_at")
  closedAt   DateTime?     @map("closed_at")
  updatedAt  DateTime      @map("updated_at")
  // Issue `closed` sem label `proplan:*` — fechada fora do fluxo do ProPlan.
  // Cai em Finalizado com badge "fechada fora do ProPlan" (SPEC-005 linha 119):
  // a falta de evidência de aceite é sinalizada, nunca disfarçada.
  closedOutside Boolean    @default(false) @map("closed_outside")
  // Hierarquia de sub-issues (SPEC-024). `parentNumber` = número do épico-pai
  // (null = raiz); `hasSubIssues` = é épico estrutural, excluído das colunas.
  // Derivados no sync via GraphQL; leitura apenas (não editamos a hierarquia).
  parentNumber Int?        @map("parent_number")
  hasSubIssues Boolean     @default(false) @map("has_sub_issues")
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
  @@index([projectId, column])
  @@map("issues")
}

enum BoardMutationType {
  move_column
  create_card
  edit_card
  discard_card
}

enum BoardMutationStatus {
  queued
  applying
  applied
  failed
}

// Auditoria e estado da fila de mutações (SPEC-005). Polling lê o status.
model BoardMutation {
  id         String              @id @default(uuid())
  projectId  String              @map("project_id")
  type       BoardMutationType
  payload    Json
  status     BoardMutationStatus @default(queued)
  error      String?
  createdAt  DateTime            @default(now()) @map("created_at")
  finishedAt DateTime?           @map("finished_at")
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("board_mutations")
}

// Os 4 fluxos de escrita do ProPlan (SPEC-010, Fatia 7.6). Uma Operation amarra
// os passos nomeados de UMA ação do usuário (promote, mapping, bootstrap,
// board_mutation) — o front faz polling por id. Estado mora aqui (não na tela):
// F5 no meio da operação volta mostrando o passo atual. NÃO é fonte do histórico
// — o histórico é projeção de leitura sobre SyncRun/Insight/BoardMutation (ADR-017).
enum OperationKind {
  promote
  mapping
  bootstrap
  assertion
}

enum OperationStatus {
  running
  done
  failed
}

model Operation {
  id         String          @id @default(uuid())
  projectId  String          @map("project_id")
  kind       OperationKind
  status     OperationStatus @default(running)
  // steps: [{ key, label, status: pending|running|done|failed }] — textos em
  // linguagem de gente, montados no domain por kind. Nunca jargão.
  steps      Json
  commitUrl  String?         @map("commit_url")
  syncRunId  String?         @map("sync_run_id")
  error      String?
  startedAt  DateTime        @default(now()) @map("started_at")
  finishedAt DateTime?       @map("finished_at")
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, startedAt])
  @@map("operations")
}

model SuppressedLink {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  sourcePath String   @map("source_path")
  targetPath String   @map("target_path")
  createdAt  DateTime @default(now()) @map("created_at")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([projectId, sourcePath, targetPath])
  @@map("suppressed_links")
}

// ===========================================================================
// MVP3 / Frente Clientes (SPEC-029, Fatia 19)
//
// Domínio DISJUNTO do board de repos: o ADR-011 continua valendo para as
// GitHub Issues (estado do board de repos vive lá, nunca aqui); o funil de
// clientes é entidade do app com transição auditada (ADR-023). Nenhum fato
// mora nos dois lugares.
//
// Colisão de nome resolvida: `Project` já é o repo GitHub. A entidade desta
// frente é `ClientProject` — nunca reusar a tabela existente (MVP3 §4).
// ===========================================================================

// Cliente do prestador. RAIZ de tenancy: carrega `tenant_id` e tem policy RLS
// própria; as filhas herdam por join a esta tabela (mesmo desenho da SPEC-022).
model Client {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  cpf       String?
  company   String?
  cnpj      String?
  email     String?
  phone     String?
  whatsapp  String?
  // Endereço: campos manuais nesta fatia — sem integração ViaCEP (SPEC-029
  // "Notas técnicas"; avaliar na SPEC-030 junto das APIs do briefing).
  zipCode   String?  @map("zip_code")
  street    String?
  district  String?
  city      String?
  state     String?
  // Notas internas do prestador — nunca expostas na rota pública do briefing.
  notes     String?
  // Exclusão LÓGICA (SPEC-029): some das listas, a linha permanece e o
  // histórico do funil não é apagado.
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projects  ClientProject[]

  // Busca por nome/empresa/CNPJ é sempre dentro do tenant.
  @@index([tenantId, deletedAt])
  @@map("clients")
}

// Estados internos do funil (mais finos que as 4 colunas da UI — MVP3 §5).
// A máquina de estados que valida as transições vive no `domain/` do módulo
// `clients` e roda NO SERVIDOR; a UI é otimista e faz rollback no 422.
enum ClientProjectState {
  DRAFT
  LINK_SENT
  BRIEFING_STARTED
  BRIEFING_SUBMITTED
  ARTIFACTS_READY
  CONTRACT_PENDING
  CONTRACT_APPROVED
  IN_PRODUCTION
  DELIVERED
  ARCHIVED
}

// Projeto de cliente — N por cliente. Filha por join a `clients` na RLS.
model ClientProject {
  id          String             @id @default(uuid())
  clientId    String             @map("client_id")
  title       String
  description String?
  state       ClientProjectState @default(DRAFT)
  deletedAt   DateTime?          @map("deleted_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transitions ClientStatusTransition[]
  briefingLinks BriefingLink[]
  briefingVersions BriefingVersion[]

  @@index([clientId, deletedAt])
  @@index([state])
  @@map("client_projects")
}

// Trilha do funil: cada mudança de estado grava de/para/ator/quando. É o que
// substitui, neste domínio, o histórico que o board de repos tem nas Issues.
model ClientStatusTransition {
  id              String             @id @default(uuid())
  clientProjectId String             @map("client_project_id")
  fromState       ClientProjectState @map("from_state")
  toState         ClientProjectState @map("to_state")
  // Nullable: transição futura disparada pelo próprio sistema (ex.: submit do
  // briefing move o card, SPEC-030) não tem usuário por trás.
  actorUserId     String?            @map("actor_user_id")
  at              DateTime           @default(now())
  clientProject   ClientProject      @relation(fields: [clientProjectId], references: [id], onDelete: Cascade)

  @@index([clientProjectId, at])
  @@map("client_status_transitions")
}

// Link público de briefing. O token de 256 bits é exibido UMA ÚNICA VEZ na
// criação; aqui persiste APENAS o hash SHA-256 (critério de aceite: nenhuma
// coluna contém o token em claro). O tenant da rota pública `GET /b/:token` é
// derivado deste hash — nunca de `workspaceId` no request (ADR-020).
model BriefingLink {
  id              String        @id @default(uuid())
  clientProjectId String        @map("client_project_id")
  tokenHash       String        @unique @map("token_hash")
  expiresAt       DateTime?     @map("expires_at")
  revokedAt       DateTime?     @map("revoked_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  clientProject   ClientProject @relation(fields: [clientProjectId], references: [id], onDelete: Cascade)
  draft           BriefingDraft?
  briefingVersions BriefingVersion[]

  @@index([clientProjectId])
  @@map("briefing_links")
}

// Trilha append-only da frente (MVP3 §3: infra compartilhada, nasce aqui).
// Nunca sofre UPDATE nem DELETE — só INSERT e leitura.
model AuditEvent {
  id       String   @id @default(uuid())
  tenantId String   @map("tenant_id")
  kind     String
  subject  String
  payload  Json?
  at       DateTime @default(now())
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, at])
  @@index([subject])
  @@map("audit_events")
}

// ===========================================================================
// MVP3 / Briefing público (SPEC-031, Fatia 20)
//
// `FileAsset` (anexos) NÃO entra aqui: depende do ADR que decide onde vive
// binário de cliente — ADR é do Cowork, e a spec §4 o exige antes do código.
// Chega no PR de anexos, depois do ADR aprovado.
// ===========================================================================

// Rascunho retomável — UM por link (SPEC-031 §2). Chaveado por `briefingLinkId`
// para que reabrir o link em outro aparelho retome de onde parou.
//
// Rascunho NÃO é versão: nada aqui é entrada do pipeline de IA. Revogar ou
// expirar o link CONGELA a linha (para de aceitar escrita, não é apagada), e o
// submit a marca como consumida — mesma regra do link revogado: a linha fica.
model BriefingDraft {
  id             String       @id @default(uuid())
  briefingLinkId String       @unique @map("briefing_link_id")
  // Etapa corrente (1..9) — devolvida no GET para retomar na tela certa.
  step           Int          @default(1)
  // Respostas parciais. Ausência é informação (ADR-014): campo não respondido
  // não vira valor inventado, fica fora do jsonb.
  answers        Json         @default("{}")
  // Marcada no submit. Não-nula ⇒ o formulário não reabre.
  consumedAt     DateTime?    @map("consumed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  briefingLink   BriefingLink @relation(fields: [briefingLinkId], references: [id], onDelete: Cascade)

  @@map("briefing_drafts")
}

// Briefing enviado. IMUTÁVEL (SPEC-031 §5): sem coluna de atualização, sem
// rota de escrita em nenhum papel — nem prestador, nem IA (MVP3 §1, espírito
// do ADR-013). Regenerar o link gera v2; a v1 permanece legível.
model BriefingVersion {
  id              String        @id @default(uuid())
  clientProjectId String        @map("client_project_id")
  briefingLinkId  String        @map("briefing_link_id")
  // Sequencial POR ClientProject — v1, v2... não é global.
  version         Int
  answers         Json
  // Idempotência: reenviar o mesmo conteúdo devolve a mesma versão em vez de
  // criar a segunda. Duplo clique e retry de rede não produzem dois briefings.
  contentHash     String        @map("content_hash")
  submittedAt     DateTime      @default(now()) @map("submitted_at")
  clientProject   ClientProject @relation(fields: [clientProjectId], references: [id], onDelete: Cascade)
  briefingLink    BriefingLink  @relation(fields: [briefingLinkId], references: [id], onDelete: Cascade)

  @@unique([clientProjectId, version])
  @@unique([briefingLinkId, contentHash])
  @@index([clientProjectId, submittedAt])
  @@map("briefing_versions")
}

// Catálogo curado de produtos/serviços da Etapa 1 (SPEC-031 §3). RAIZ de
// tenancy: `tenant_id` próprio e policy RLS direta.
//
// O cliente escolhe da lista E pode digitar item livre — o que ele digita fica
// só na resposta do briefing, nunca cria linha aqui (não polui o catálogo).
model ServiceCatalogItem {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  segment   String
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, segment, label])
  @@index([tenantId, segment, active])
  @@map("service_catalog_items")
}

// Localidades do IBGE, EMBARCADAS VIA SEED (SPEC-031 §3) — nunca consumidas da
// API do IBGE em runtime: o formulário público ficaria refém de um terceiro no
// caminho do cliente, e IBGE fora do ar viraria briefing travado. Atualizar é
// reseed (manutenção), não request.
//
// Dado de referência COMPARTILHADO: não tem `tenant_id` e não leva RLS — é a
// mesma lista de estados/cidades do Brasil para todo mundo.
model State {
  id     String @id @default(uuid())
  // Sigla (UF): 'SP', 'RJ'...
  code   String @unique
  name   String
  cities City[]

  @@map("states")
}

model City {
  id      String @id @default(uuid())
  stateId String @map("state_id")
  // Código IBGE do município — chave estável para reseed idempotente.
  ibgeId  Int    @unique @map("ibge_id")
  name    String
  state   State  @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@index([stateId, name])
  @@map("cities")
}

// Segmentos derivados de CNAE, também por seed e também compartilhados.
model Segment {
  id    String @id @default(uuid())
  code  String @unique
  label String

  @@map("segments")
}
