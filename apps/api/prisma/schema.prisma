generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(uuid())
  githubId             BigInt    @unique @map("github_id")
  login                String
  name                 String?
  avatarUrl            String?   @map("avatar_url")
  encryptedGithubToken String    @map("encrypted_github_token")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  projects             Project[]

  @@map("users")
}

model Project {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  githubRepoId BigInt   @map("github_repo_id")
  owner        String
  name         String
  description  String?
  defaultBranch String  @map("default_branch")
  isPrivate    Boolean  @map("is_private")
  docsScopeHash String? @map("docs_scope_hash")
  lastSyncAt   DateTime? @map("last_sync_at")
  lastDocsCommitAt   DateTime? @map("last_docs_commit_at")
  lastCodeCommitAt   DateTime? @map("last_code_commit_at")
  commitMetaSyncedAt DateTime? @map("commit_meta_synced_at")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents    Document[]
  syncRuns     SyncRun[]
  insights     Insight[]

  @@unique([userId, githubRepoId])
  @@map("projects")
}

model Document {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  path           String
  blobSha        String   @map("blob_sha")
  content        String
  frontmatter    Json?
  isConventional Boolean  @default(false) @map("is_conventional")
  byteSize       Int      @map("byte_size")
  updatedAt      DateTime @updatedAt @map("updated_at")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outLinks       DocLink[] @relation("source")
  inLinks        DocLink[] @relation("target")

  @@unique([projectId, path])
  @@map("documents")
}

enum DocLinkKind {
  explicit
}

model DocLink {
  id               String      @id @default(uuid())
  projectId        String      @map("project_id")
  sourceDocumentId String      @map("source_document_id")
  targetDocumentId String?     @map("target_document_id")
  targetPath       String      @map("target_path")
  kind             DocLinkKind @default(explicit)
  anchor           String?
  source           Document    @relation("source", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  target           Document?   @relation("target", fields: [targetDocumentId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([sourceDocumentId])
  @@map("doc_links")
}

enum SyncStatus {
  queued
  running
  success
  noop
  failed
}

enum LlmProvider {
  anthropic
  openai
  openrouter
}

model Settings {
  id                        String      @id @default(uuid())
  userId                    String      @unique @map("user_id")
  llmProvider               LlmProvider @default(anthropic) @map("llm_provider")
  docsStalenessThresholdDays Int        @default(90) @map("docs_staleness_threshold_days")
  updatedAt                 DateTime    @updatedAt @map("updated_at")

  @@map("settings")
}

enum InsightKind {
  summary
  status_bootstrap
}

model Insight {
  id           String      @id @default(uuid())
  projectId    String      @map("project_id")
  kind         InsightKind
  docsTreeSha  String      @map("docs_tree_sha")
  provider     String
  model        String
  inputTokens  Int         @map("input_tokens")
  outputTokens Int         @map("output_tokens")
  content      Json
  createdAt    DateTime    @default(now()) @map("created_at")
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, kind, createdAt])
  @@map("insights")
}

model SyncRun {
  id            String     @id @default(uuid())
  projectId     String     @map("project_id")
  status        SyncStatus
  docsScopeHash String?    @map("docs_scope_hash")
  added         Int        @default(0)
  updated       Int        @default(0)
  removed       Int        @default(0)
  skipped       Int        @default(0)
  error         String?
  startedAt     DateTime   @default(now()) @map("started_at")
  finishedAt    DateTime?  @map("finished_at")
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, startedAt])
  @@map("sync_runs")
}
