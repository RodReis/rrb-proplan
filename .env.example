# Banco e Redis (docker-compose já provê em rede interna)
# Portas de host remapeadas (5432/6379 usadas por outro stack local): 5433/6380.
DATABASE_URL=postgresql://proplan:proplan@localhost:5433/proplan
REDIS_URL=redis://localhost:6380

# GitHub OAuth App (Settings > Developer settings > OAuth Apps — NÃO GitHub App)
# Homepage URL:            http://localhost:5180
# Authorization callback:  http://localhost:3311/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sessão e criptografia
# JWT_SECRET: string aleatória longa (ex.: openssl rand -hex 32)
# TOKEN_ENCRYPTION_KEY: exatamente 32 bytes em hex (openssl rand -hex 32)
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

FRONTEND_URL=http://localhost:5180

# API (porta remapeada: 3000 é disputada por outros stacks locais)
API_PORT=3311
API_URL=http://localhost:3311

# Provedores de IA (ADR-008; provedor sem chave fica desabilitado na tela de Configurações)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
HERMES_API_KEY=

# Modelo por provedor (não vai na UI nesta fatia — SPEC-003)
LLM_MODEL_ANTHROPIC=claude-sonnet-5
LLM_MODEL_OPENAI=gpt-4o
LLM_MODEL_OPENROUTER=anthropic/claude-3.5-sonnet

# Fatias futuras
GITHUB_WEBHOOK_SECRET=
