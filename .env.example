# Banco e Redis (docker-compose já provê em rede interna)
# Portas de host remapeadas (5432/6379 usadas por outro stack local): 5433/6380.
DATABASE_URL=postgresql://proplan:proplan@localhost:5433/proplan
REDIS_URL=redis://localhost:6380

# GitHub App (Settings > Developer settings > GitHub Apps — NÃO OAuth App).
# Ver README "Criar o GitHub App" para o passo-a-passo (permissões, callback,
# gerar a chave privada em base64). ADR-015 / SPEC-008.
# Callback de autorização: http://localhost:3311/auth/github/callback
GITHUB_APP_ID=              # ID numérico do App (App settings > About)
GITHUB_APP_CLIENT_ID=       # Client ID do App (formato Iv23...)
GITHUB_APP_CLIENT_SECRET=   # Client secret do App
GITHUB_APP_SLUG=            # slug da URL do App (github.com/apps/<slug>)
# PEM da chave privada em base64 (uma linha):
#   base64 -w0 chave.pem            (Linux)
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("chave.pem"))   (PowerShell)
GITHUB_APP_PRIVATE_KEY=

# Sessão e criptografia
# JWT_SECRET: string aleatória longa (ex.: openssl rand -hex 32)
# TOKEN_ENCRYPTION_KEY: exatamente 32 bytes em hex (openssl rand -hex 32)
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

FRONTEND_URL=http://localhost:5180

# API (porta remapeada: 3000 é disputada por outros stacks locais)
API_PORT=3311
API_URL=http://localhost:3311

# Provedores de IA (ADR-008; provedor sem chave fica desabilitado na tela de Configurações)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
HERMES_API_KEY=

# Modelo por provedor (não vai na UI nesta fatia — SPEC-003)
LLM_MODEL_ANTHROPIC=claude-sonnet-5
LLM_MODEL_OPENAI=gpt-4o
LLM_MODEL_OPENROUTER=anthropic/claude-3.5-sonnet

# Modelo da frente de ARTEFATOS (SPEC-032 §2.4): um só para a frente inteira.
# Env próprio, e não o LLM_MODEL_ANTHROPIC acima, porque o insight roda no
# global — trocá-lo para Haiku mudaria o resumo de projeto junto.
LLM_MODEL_ARTIFACTS=claude-haiku-4-5-20251001

# Fatias futuras
GITHUB_WEBHOOK_SECRET=
