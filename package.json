{
  "name": "rrb-proplan",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm infra:up && pnpm -r --parallel dev",
    "infra:up": "docker compose up -d --wait postgres redis",
    "dev:api": "pnpm --filter @proplan/api start:dev",
    "dev:web": "pnpm --filter @proplan/web dev",
    "build": "pnpm --filter @proplan/api build && pnpm --filter @proplan/web build",
    "prisma:migrate": "pnpm --filter @proplan/api prisma:migrate",
    "prisma:seed": "pnpm --filter @proplan/api prisma:seed",
    "bootstrap:role": "node scripts/bootstrap-app-role.mjs",
    "test:report": "node scripts/test-report.mjs",
    "test:report:check": "node scripts/test-report.mjs --check",
    "test:report:selfcheck": "node scripts/test-report.mjs --selfcheck"
  }
}
